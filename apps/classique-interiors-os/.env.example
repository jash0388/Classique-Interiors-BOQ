DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
CRON_SECRET="replace-with-a-random-secret-for-the-production-purge-job"
STORAGE="local"
# Optional: set STORAGE=blob and configure BLOB_READ_WRITE_TOKEN for Vercel Blob.
# Set SEED_DEFAULT_PASSWORD to a unique password before running db:seed.
